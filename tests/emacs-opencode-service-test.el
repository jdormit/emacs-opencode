;;; emacs-opencode-service-test.el --- Shared service tests -*- lexical-binding: t; -*-

(require 'ert)
(require 'emacs-opencode)

(ert-deftest test-opencode-service/two-directories-one-stream ()
  (let ((opencode--service-connection nil)
        (opens 0) connections directories)
    (cl-letf (((symbol-function 'opencode-connection-start)
               (lambda (connection ready &optional _error)
                 (setf (opencode-connection-connected connection) t)
                 (funcall ready connection)))
              ((symbol-function 'opencode-sse-open)
               (lambda (conn)
                 (setf (opencode-connection-sse-process conn) 'stream)
                 (cl-incf opens))))
      (dolist (directory '("/tmp/one/" "/tmp/two/"))
        (opencode-run-server
         directory (lambda (connection)
                     (push connection connections)
                     (push default-directory directories))))
      (should (eq (car connections) (cadr connections)))
      (should (= opens 1))
      (should (equal directories '("/tmp/two/" "/tmp/one/"))))))

(ert-deftest test-opencode-service/request-retains-directory-in-callback ()
  (let ((conn (opencode-connection-create :base-url "http://localhost:1"))
        callback headers received)
    (cl-letf (((symbol-function 'request)
               (lambda (_url &rest args)
                 (setq headers (plist-get args :headers)
                       callback (plist-get args :success)))))
      (let ((default-directory "/tmp/one/"))
        (opencode-request conn 'GET "/api/agent"
                          :success (lambda (&rest _) (setq received default-directory))))
      (let ((default-directory "/tmp/two/")) (funcall callback))
      (should (equal (cdr (assoc "x-opencode-directory" headers))
                     (url-hexify-string (directory-file-name (file-truename "/tmp/one/")))))
      (should (equal received "/tmp/one/")))))

(ert-deftest test-opencode-service/catalogs-are-directory-local ()
  (let ((conn (opencode-connection-create :shared t)))
    (let ((default-directory "/tmp/one/"))
      (setf (opencode-connection-agents (opencode-connection-context conn)) '("one")))
    (let ((default-directory "/tmp/two/"))
      (should-not (opencode-connection-agents (opencode-connection-context conn))))))

(ert-deftest test-opencode-service/reconnect-rediscovers ()
  (let* ((conn (opencode-connection-create :connected t :sse-process 'old))
         ready opened)
    (cl-letf (((symbol-function 'opencode-connection-start)
               (lambda (_conn callback &optional _error) (setq ready callback)))
              ((symbol-function 'opencode-sse-close) #'ignore)
              ((symbol-function 'opencode-sse-open)
               (lambda (connection) (setq opened (opencode-connection-password connection)))))
      (opencode-sse--reconnect conn 'old)
      (should ready)
      (should-not opened)
      (setf (opencode-connection-password conn) "replacement")
      (funcall ready conn)
      (should (equal opened "replacement")))))

(ert-deftest test-opencode-service/new-directory-recovers-pending-requests ()
  (let ((opencode--service-connection
         (opencode-connection-create :shared t :connected t :sse-connected t :sse-process 'stream))
        queried)
    (cl-letf (((symbol-function 'opencode-session--prompt-pending-requests)
               (lambda (_) (push default-directory queried))))
      (opencode-run-server "/tmp/one/")
      (opencode-run-server "/tmp/two/")
      (opencode-run-server "/tmp/one/")
      (should (equal queried '("/tmp/two/" "/tmp/one/"))))))

(ert-deftest test-opencode-service/oauth-retry-retains-directory ()
  (let ((conn (opencode-connection-create :shared t))
        retry queried)
    (cl-letf (((symbol-function 'opencode-client-integration-oauth-status)
               (lambda (_conn _provider _attempt &rest args)
                 (push default-directory queried)
                 (when (= (length queried) 1)
                   (funcall (plist-get args :success) :data '((status . "pending"))))))
              ((symbol-function 'run-at-time)
               (lambda (_time _repeat function &rest args)
                 (setq retry (lambda () (apply function args))))))
      (let ((default-directory "/tmp/one/"))
        (opencode-session--auth-oauth-poll conn "mock" "attempt" #'ignore))
      (let ((default-directory "/tmp/two/")) (funcall retry))
      (should (equal queried '("/tmp/one/" "/tmp/one/"))))))

(ert-deftest test-opencode-service/disconnect-cancels-discovery ()
  (let ((conn (opencode-connection-create)) response ready)
    (cl-letf (((symbol-function 'opencode-connection--read-registration)
               (lambda () '((url . "http://localhost:1") (pid . 42))))
              ((symbol-function 'opencode-client-health)
               (lambda (_conn &rest args) (setq response (plist-get args :success)))))
      (opencode-connection-start conn (lambda (_) (setq ready t)))
      (opencode-connection-stop conn)
      (funcall response :data '((pid . 42) (version . "2.0.29")))
      (should-not ready)
      (should-not (opencode-connection-connected conn)))))

(provide 'emacs-opencode-service-test)
;;; emacs-opencode-service-test.el ends here
