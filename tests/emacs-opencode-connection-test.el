;;; emacs-opencode-connection-test.el --- Connection tests -*- lexical-binding: t; -*-

(require 'ert)
(require 'emacs-opencode-client)

(ert-deftest test-opencode-connection/registration-xdg ()
  (let ((process-environment (copy-sequence process-environment)))
    (setenv "XDG_STATE_HOME" "/tmp/isolated-state")
    (should (equal (opencode-connection-registration-file)
                   "/tmp/isolated-state/opencode/service.json"))
    (setenv "XDG_STATE_HOME" nil)
    (should (equal (opencode-connection-registration-file)
                   (expand-file-name "~/.local/state/opencode/service.json")))))

(ert-deftest test-opencode-connection/discover-auth-and-replacement ()
  (let* ((conn (opencode-connection-create))
         (info '((url . "http://localhost:49406") (pid . 42) (password . "first")))
         ready)
    (cl-letf (((symbol-function 'opencode-connection--read-registration) (lambda () info))
              ((symbol-function 'opencode-client-health)
               (lambda (probe &rest args)
                 (should (equal (opencode-connection-password probe) (alist-get 'password info)))
                 (funcall (plist-get args :success)
                          :data `((pid . ,(alist-get 'pid info)) (version . "2.0.29"))))))
      (opencode-connection-start conn (lambda (_) (setq ready t)))
      (should ready)
      (should (equal (opencode-connection-password conn) "first"))
      (setq info '((url . "http://localhost:49407") (pid . 43) (password . "next")))
      (opencode-connection-start conn #'ignore)
      (should (equal (opencode-connection-password conn) "next"))
      (should (equal (opencode-connection-base-url conn) "http://localhost:49407")))))

(ert-deftest test-opencode-connection/discover-rejects-wrong-pid ()
  (let ((conn (opencode-connection-create)) failed)
    (cl-letf (((symbol-function 'opencode-connection--read-registration)
               (lambda () '((url . "http://localhost:1") (pid . 42))))
              ((symbol-function 'opencode-client-health)
               (lambda (_probe &rest args)
                 (funcall (plist-get args :success) :data '((pid . 43) (version . "2"))))))
      (opencode-connection--discover conn #'ignore (lambda () (setq failed t)))
      (should failed)
      (should-not (opencode-connection-registration conn)))))

(ert-deftest test-opencode-connection/start-uses-cli-and-queues-callers ()
  (let ((conn (opencode-connection-create)) sentinel command calls (probes 0))
    (cl-letf (((symbol-function 'opencode-connection--discover)
               (lambda (connection ready fail)
                 (if (= (cl-incf probes) 1) (funcall fail) (funcall ready connection))))
              ((symbol-function 'make-process)
               (lambda (&rest args)
                 (setq command (plist-get args :command)
                       sentinel (plist-get args :sentinel))
                 'startup))
              ((symbol-function 'process-status) (lambda (_) 'exit))
              ((symbol-function 'process-exit-status) (lambda (_) 0)))
      (opencode-connection-start conn (lambda (_) (push 'one calls)))
      (opencode-connection-start conn (lambda (_) (push 'two calls)))
      (should (equal command '("opencode" "service" "start")))
      (should-not calls)
      (funcall sentinel 'startup "finished")
      (should (equal calls '(two one)))
      (should (= probes 2)))))

(ert-deftest test-opencode-connection/empty-model-catalog-is-loaded ()
  (let ((conn (opencode-connection-create :directory "/tmp/")) (fetches 0))
    (cl-letf (((symbol-function 'opencode-client-models)
               (lambda (_conn &rest args) (cl-incf fetches) (funcall (plist-get args :success) :data nil)))
              ((symbol-function 'opencode-client-integrations)
               (lambda (_conn &rest args) (funcall (plist-get args :success) :data nil))))
      (opencode-connection-ensure-models conn)
      (opencode-connection-ensure-models conn)
      (should (= fetches 1))
      (should (eq (opencode-connection-models-state conn) :loaded))
      (opencode-connection-invalidate-models conn)
      (opencode-connection-ensure-models conn)
      (should (= fetches 2)))))

(ert-deftest test-opencode-connection/empty-command-list-is-loaded ()
  (let ((conn (opencode-connection-create :directory "/tmp/")) (fetches 0))
    (cl-letf (((symbol-function 'opencode-client-commands)
               (lambda (_conn &rest args) (cl-incf fetches) (funcall (plist-get args :success) :data nil))))
      (opencode-connection-ensure-commands conn)
      (opencode-connection-ensure-commands conn)
      (should (= fetches 1)))))

(ert-deftest test-opencode-connection/invalidated-load-is-discarded ()
  (let ((conn (opencode-connection-create :directory "/tmp/")) callbacks)
    (cl-letf (((symbol-function 'opencode-client-models)
               (lambda (_conn &rest args) (push (plist-get args :success) callbacks)))
              ((symbol-function 'opencode-client-integrations)
               (lambda (_conn &rest args) (push (plist-get args :success) callbacks))))
      (opencode-connection-ensure-models conn)
      (opencode-connection-invalidate-models conn)
      (dolist (callback callbacks) (funcall callback :data '(stale)))
      (should-not (opencode-connection-models-state conn))
      (should-not (opencode-connection-models conn)))))

(provide 'emacs-opencode-connection-test)
;;; emacs-opencode-connection-test.el ends here
